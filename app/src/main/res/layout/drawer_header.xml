<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="220dp"
    android:background="@drawable/bg_gradient_primary"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_chip_red"
        android:gravity="center"
        android:text="RP"
        android:textColor="@color/redpulse_chip_red_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDrawerUserName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Red Pulse Member"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDrawerUserEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="blood support community"
        android:textColor="#FFF6F6"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvDrawerRole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_chip_red"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="24/7 Emergency support"
        android:textColor="@color/redpulse_chip_red_text"
        android:textStyle="bold" />
</LinearLayout>
